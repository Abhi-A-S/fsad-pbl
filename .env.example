# ============================================================
# ResearchForge — environment variable template
#
# Copy this file to .env and fill in real values before
# starting the server. Never commit .env to version control.
# ============================================================

# Application environment.
# Accepted values: development | production | test
NODE_ENV=development

# TCP port the Express server listens on.
PORT=5000

# MongoDB connection string.
# For local development use the 127.0.0.1 form (avoids IPv6 resolution issues).
MONGODB_URI=mongodb://127.0.0.1:27017/researchforge

# Secret used to sign and verify JSON Web Tokens.
# Must be a long, random, unpredictable string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# Lifetime of issued JWTs.
# Uses the format accepted by the jsonwebtoken library (e.g. 1d, 7d, 2h).
JWT_EXPIRES_IN=1d

